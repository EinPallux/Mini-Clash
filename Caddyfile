# Mini Clash edge (TECH §1): TLS/wss termination + static client.
# DOMAIN=play.example.com gets automatic HTTPS; unset serves plain :80 (dev).
#
# Everything netcode flows under /ws — the client's serverEndpoint() derives
# wss://host/ws, and colyseus.js runs its matchmake HTTP calls plus the lobby
# code lookup under the same prefix, so one stripped route covers it all.
{$DOMAIN::80} {
	encode zstd gzip

	handle_path /ws/* {
		reverse_proxy game:2567
	}

	# Same origin as the client, so the session cookie is a first-party cookie
	# and needs no CORS story at all (TECH §10).
	handle_path /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv/client
		try_files {path} /index.html
		file_server
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header /game-assets/* Cache-Control "public, max-age=86400"
	}
}
