# Mini Clash deployment configuration.
#
# `sudo ./deploy/setup.sh` generates a real .env from this template with fresh
# secrets. Copy it by hand only if you know what you are putting in the blanks.
#
# Keep the real .env off git (it is in .gitignore) and keep a copy somewhere
# safe: neither secret below can be recovered, and losing them costs you the
# database and the api↔game link respectively.

# The domain Caddy gets a certificate for. Its DNS record must already point at
# this box — Let's Encrypt validates over port 80. Leave it as `:80` to serve
# plain HTTP for a local or IP-only trial.
DOMAIN=:80

# Postgres superuser password for the `mc` role. Any long random string.
#   openssl rand -base64 24 | tr -d '\n=' | tr '+/' '-_'
POSTGRES_PASSWORD=

# Shared secret between the game server and the api. At least 16 characters —
# the api refuses to record matches with anything weaker, which means nobody
# gets paid, which is the failure you want rather than an open endpoint that
# anybody can post fabricated match results to.
#   openssl rand -base64 48 | tr -d '\n=' | tr '+/' '-_'
MC_INTERNAL_SECRET=
